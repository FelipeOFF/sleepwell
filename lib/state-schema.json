{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FelipeOFF/sleepwell/state-schema.json",
  "title": "sleepwell state",
  "description": "Estado persistente do loop sleepwell. Vive em .sleepwell/state.json no repo onde o loop roda. Schema v2: campos novos opcionais permitem evolução sem quebrar runs antigas (v1). Migration: states v1 carregam normalmente; novos campos assumem defaults. Ver lib/ritual.md §8 para detalhes.",
  "type": "object",
  "required": [
    "version",
    "intent",
    "slug",
    "mode",
    "branch",
    "iteration",
    "max_iter",
    "consecutive_failures",
    "total_passes",
    "total_fails",
    "started_at",
    "status"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Versão do schema. v1 = legado, v2 = atual (default em novas runs). v1 ainda é aceito para retomadas."
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "description": "Frase original do usuário."
    },
    "intent_file": {
      "type": ["string", "null"],
      "default": null,
      "description": "Caminho para arquivo de intent longo (alternativa a string inline). v2."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Slug kebab-case derivado do intent."
    },
    "mode": {
      "enum": ["tidy", "refine", "build", "radical"],
      "description": "Modo de operação."
    },
    "branch": {
      "type": "string",
      "pattern": "^sleepwell/.+",
      "description": "Branch isolada do loop."
    },
    "worktree_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Flag persistida do CLI (--no-worktree → false). v2."
    },
    "worktree_path": {
      "type": ["string", "null"],
      "description": "Path absoluto do worktree, ou null se rodando sem worktree."
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "description": "Iterações já EXECUTADAS (pass ou fail)."
    },
    "max_iter": {
      "type": "integer",
      "minimum": 1,
      "default": 20
    },
    "stop_when": {
      "type": ["string", "null"],
      "description": "Condição NL avaliada ao fim de cada iter."
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "no_voice": {
      "type": "boolean",
      "default": false,
      "description": "Flag persistida do CLI (--no-voice). Pula extração de voice profile. v2."
    },
    "no_meta": {
      "type": "boolean",
      "default": false,
      "description": "Flag persistida do CLI (--no-meta). Pula meta-calibration. v2."
    },
    "consecutive_failures": {
      "type": "integer",
      "minimum": 0,
      "description": "Reset a 0 a cada PASS. ≥3 → abort."
    },
    "total_passes": {
      "type": "integer",
      "minimum": 0
    },
    "total_fails": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_iter_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "stopped_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "enum": ["running", "done", "aborted", "stopped"]
    },
    "verify_cmds": {
      "type": "object",
      "description": "Comandos de verificação. Cada campo aceita um comando shell ou o sentinel literal \"auto\" (loop detecta no boot).",
      "properties": {
        "lint": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "const": "auto" }
          ],
          "description": "Comando de lint, ou \"auto\" para detecção automática."
        },
        "typecheck": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "const": "auto" }
          ],
          "description": "Comando de type-check, ou \"auto\"."
        },
        "test": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "const": "auto" }
          ],
          "description": "Comando de testes, ou \"auto\"."
        }
      },
      "additionalProperties": false
    },
    "tokens_used": {
      "type": "object",
      "description": "Acumulado de tokens consumidos pelo loop. v2.",
      "properties": {
        "input":          { "type": "integer", "minimum": 0, "default": 0 },
        "output":         { "type": "integer", "minimum": 0, "default": 0 },
        "cache_read":     { "type": "integer", "minimum": 0, "default": 0 },
        "cache_creation": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "cost_so_far_usd": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Custo acumulado em USD (derivado de tokens_used). v2."
    },
    "cost_budget_usd": {
      "type": ["number", "null"],
      "minimum": 0,
      "default": null,
      "description": "Orçamento configurado via --max-cost <USD>. Quando cost_so_far_usd >= cost_budget_usd → abort. v2."
    },
    "voice_profile_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Quando o voice profile cacheado foi gerado."
    },
    "calibration_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Quando a calibration foi gerada."
    },
    "abort_reason": {
      "type": ["string", "null"]
    }
  }
}
